{
	"name": "roomqu",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"demo:reset": "node --experimental-strip-types scripts/reset-integrated.ts",
		"dev:demo": "vite dev --host 127.0.0.1 --port 1231",
		"test:integrated": "node --experimental-strip-types scripts/test-integrated.ts",
		"prototype:reset": "node --experimental-strip-types scripts/reset-demo.ts",
		"test:prototype": "node --experimental-strip-types --test tests/demo.test.ts",
		"test:prototype:http": "node --experimental-strip-types scripts/check-http.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
